# Copia este archivo como .env y rellena tus claves. NUNCA subas .env al repositorio.
ELEVENLABS_API_KEY=
# ID de la voz en español elegida (ver: python main.py voces-listar)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2
# Estimación contable del coste de voz según tu plan
EUR_POR_1000_CARACTERES=0.16
# Horas de publicación (hipótesis inicial; cámbialas según tus analíticas)
PTS_HORAS=13:30,20:30
