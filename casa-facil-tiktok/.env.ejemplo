# Copia este archivo como .env y rellena tus claves. NUNCA subas el .env a internet.

# --- ElevenLabs (voz) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_SPEED=1.05
ELEVENLABS_STABILITY=0.45

# --- De dónde salen los clips: kling o pexels ---
FUENTE_VIDEO=kling

# --- Kling (vídeo IA) ---
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-1-master
KLING_MODE=std
KLING_DURATION=5

# --- Pexels (vídeos de stock gratis, alternativa a Kling) ---
PEXELS_API_KEY=

# --- Aspecto del vídeo ---
FUENTE_LETRA=Arial
FIRMA=@casafaciltrucos
VOLUMEN_MUSICA=0.12
